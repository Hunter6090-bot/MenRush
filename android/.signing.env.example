# Copy to .signing.env (gitignored). Values must match android/android.keystore.
BUBBLEWRAP_KEYSTORE_PASSWORD=
BUBBLEWRAP_KEY_PASSWORD=
MENRUSH_KEY_ALIAS=menrush
# Colon-hex SHA-256 from: keytool -list -v -keystore android.keystore -alias menrush
MENRUSH_CERT_SHA256=36:7F:1E:FC:87:03:58:74:2B:BC:3D:71:1B:BF:F0:EA:C5:BF:9C:12:CD:CB:95:06:71:8B:F1:1C:CC:48:8F:06
