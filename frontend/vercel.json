{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-production-d587.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://backend-production-d587.up.railway.app/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://backend-production-d587.up.railway.app/socket.io/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
