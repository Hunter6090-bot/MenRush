{
  "name": "menrush-backend",
  "version": "1.0.0",
  "description": "Location-based social discovery platform",
  "main": "dist/boot.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/boot.js",
    "db:migrate": "ts-node src/scripts/migrate.ts",
    "db:seed-test-users": "ts-node scripts/seed-test-users.ts",
    "db:seed-social-oct1": "ts-node scripts/seed-social-oct1-2026.ts",
    "test:social-oct1": "ts-node scripts/test-social-oct1-seed.ts",
    "waitlist:import": "ts-node src/scripts/import-waitlist.ts",
    "hotspots:import": "ts-node scripts/import-hot-spots.ts",
    "invite:generate": "ts-node src/scripts/generate-invite-codes.ts",
    "invite:send-wave-2": "ts-node src/scripts/send-wave-2-invites.ts",
    "notify:id-verification-paused": "ts-node src/scripts/send-id-verification-paused.ts",
    "verification:purge-sensitive": "ts-node src/scripts/purge-verification-files.ts",
    "test:security": "ts-node scripts/security-checks.ts",
    "test:veriff": "ts-node --transpile-only scripts/veriff-checks.ts",
    "test:video-note-mime": "ts-node scripts/video-note-mime-checks.ts",
    "test:discovery-age-filter": "ts-node scripts/discovery-age-filter-checks.ts",
    "test:discreet-media-blur": "ts-node scripts/discreet-media-blur-checks.ts",
    "test:my-photos": "ts-node scripts/my-photos-checks.ts",
    "test:pride-one-path": "ts-node scripts/pride-one-path-checks.ts",
    "test:official-rooms": "ts-node scripts/official-rooms-checks.ts",
    "test:nightlife-checkin": "ts-node scripts/nightlife-checkin-checks.ts",
    "test:nightlife-integration": "ts-node scripts/nightlife-checkin-integration.ts",
    "test:push": "ts-node scripts/test-push.ts",
    "test:features": "bash ../test-features.sh",
    "test:smoke": "node ../scripts/smoke-critical-path.mjs",
    "test:image-optimize": "ts-node scripts/image-optimize-checks.ts",
    "test:nearby-hotpath": "ts-node scripts/nearby-hotpath-checks.ts",
    "test:chat-video-open": "ts-node scripts/chat-video-open-checks.ts",
    "predeploy": "npm run build && bash ../test-features.sh",
    "audit:safety": "bash ../scripts/audit-safety.sh"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.21",
    "@napi-rs/canvas": "^1.0.1",
    "@sentry/node": "^10.57.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@types/multer": "^2.1.0",
    "@types/web-push": "^3.6.4",
    "@vladmandic/face-api": "^1.7.15",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "otplib": "^12.0.1",
    "pg": "^8.8.0",
    "qs": "^6.15.0",
    "resend": "^6.12.3",
    "sharp": "^0.35.2",
    "socket.io": "^4.5.4",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
